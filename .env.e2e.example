# Ambiente e2e local (docker compose --profile e2e up -d). Copie para .env.e2e.
# O servidor em NODE_ENV=test e o seed recusam banco ou SMTP que não sejam
# locais, e o seed recusa banco cujo nome não termine em _e2e.
PORT=3334
DATABASE_URL=postgres://postgres:postgres@localhost:5434/sgb_e2e
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
API_KEY=api_key_e2e
APP_SECRET_KEY=app_secret_key_e2e
APP_SECRET_KEY_EXPIRES_IN=3600
DB_SYNCHRONIZE=false
NODE_ENV=test
CORS_ALLOWED_ORIGIN=http://localhost:4173
TRUST_PROXY_HOPS=0
