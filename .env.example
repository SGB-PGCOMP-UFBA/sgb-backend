EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
API_KEY=api_key_example
APP_SECRET_KEY=key_example
APP_SECRET_KEY_EXPIRES_IN=3600
